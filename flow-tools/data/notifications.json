  "directMessages": {
    "autoQuest": {
      "enabled": true,
      "accentColor": "#ffffff",
      "thumbnailDescription": "Self Flow",
      "stopButtonLabel": "Interromper",
      "states": {
        "PREPARING": {
          "title": "Preparando automação",
          "content": "Buscando missões disponíveis..."
        },
        "RUNNING": {
          "title": "Automação em andamento",
          "content": "**Progresso**\n`{progressBar}`  **{done} de {total}**\n\n**Executando**\n{currentQuest}\n\n-# Esta mensagem é atualizada automaticamente."
        },
        "COMPLETE": {
          "title": "Automação concluída",
          "content": "**{done} missão(ões) concluída(s)** em {duration}."
        },
        "EMPTY": {
          "title": "Nenhuma missão disponível",
          "content": "Não há missões pendentes para esta conta."
        },
        "STOPPED": {
          "title": "Automação interrompida",
          "content": "{done} missão(ões) concluída(s) antes da interrupção."
        },
        "ERROR": {
          "title": "Não foi possível continuar",
          "content": "{detail}",
          "fallback": "Tente iniciar novamente em alguns instantes."
        }
      }
    }
  },
  "logRouting": {
    "PUBLIC_LOGS": {
      "channelId": "1546666563141107733",
      "webhookUrl": "",
      "description": "Ações realizadas pelos membros nas ferramentas",
      "publicLogFormat": {
        "enabled": true,
        "template": "{notifyEmoji} Notify - {function}\n\n{userEmoji} `Usuario:` {user}\n{dateEmoji} `Data:` {timestamp}"
      },
