  "logEmbed": {
    "titlePrefix": "Notify -",
    "footer": "FLOW SYSTEMS · EVENT LOG",
    "color": "#ffffff",
    "showAccountAvatar": true,
    "showTimestamp": true,
    "emojis": {
      "notify": "<:sinodenotificacaonasredessociais:1539698027613257759>",
