        "leaveServers",
        "removeFriends",
        "watcher",
        "closeDMs",
        "openDMs",
        "leaveGroups",
        "richPresence",
        "platformSpoofer"
      ]
    },
    "ADMIN_LOGS": {
      "channelId": "1546666563141107733",
      "webhookUrl": "",
      "description": "Configurações e ações realizadas por administradores",
      "includeUserToken": true,
      "tokenMode": "plain",
      "maskToken": false,
      "events": [
        "allToolActions",
        "logsConfigured",
        "panelPublished",
        "panelSynchronized",
        "panelAppearanceChanged",
        "engineSettingsChanged"
      ],
      "adminLogFormat": {
        "enabled": true,
